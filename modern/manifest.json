{
  "manifest_version": 3,
  "name": "WhaFlash Modern",
  "version": "0.1.4",
  "description": "CRM moderno e modular para WhatsApp Web.",
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["assets/pageBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": { "default_title": "WhaFlash", "default_popup": "index.html" }
}
