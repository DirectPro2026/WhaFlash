{
  "manifest_version": 3,
  "name": "WhaFlash Modern",
  "version": "0.2.0",
  "description": "CRM modular para WhatsApp Web, reconstruído em TypeScript.",
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["assets/pageBridge.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["assets/content.js"], "run_at": "document_idle", "world": "ISOLATED" }
  ],
  "web_accessible_resources": [{ "resources": ["index.html", "assets/*"], "matches": ["https://web.whatsapp.com/*"] }],
  "action": { "default_title": "WhaFlash", "default_popup": "index.html" }
}
